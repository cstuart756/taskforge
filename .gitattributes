# Normalise line endings to LF in the repository
* text=auto eol=lf

# Explicitly declare text files to be normalised and checked out with LF
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.prisma text eol=lf
*.sql   text eol=lf
*.toml  text eol=lf
*.env.example text eol=lf

# Windows-specific files get CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary files should not be modified
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text eol=lf
*.woff  binary
*.woff2 binary